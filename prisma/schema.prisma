// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Поставщики
model provider {
  id                          Int                @id @default(autoincrement())
  name                        String? // Наименование поставщика или ФИО
  imageProviders              String // Фото Руководителя
  logoSupplierCompany         String // Лого компании поставщика 
  isActive                    Boolean            @default(false) // Активен или нет Поставщик
  description                 String // Описание Поставщика
  supplierEvaluation          Decimal?           @default(0) @db.Decimal(10, 2) // Оценка поставщика 
  minOrderBatch               Int // Минимальная цена заказа
  registeredAddress           String // Юридический адрес
  actualAddress               String // Фактический адрес
  correspondencePostalAddress String // Корреспондентский Почтовый адрес
  numberPhone                 String // Номер телефона
  postalAddress               String // Офиц. Адресс почты
  suppliersWebsite            String? // Сайт поставщика
  fioOfTheHead                String // ФИО руководителя
  docOfTheHead                String // Документ подтверждающий полномочия руководителя
  createTime                  DateTime           @default(now()) // Время Создания
  catalog                     CatalogProviders[] // Каталог товаров поставщика
  isDeleted                   Boolean            @default(false)
  deletedAt                   DateTime?
}

// Еденицы изменения
enum Unit {
  PIECE
  KG
  METER
  PALLET
}

// Каталог товаров поставщика
model CatalogProviders {
  id                  Int                  @id @default(autoincrement())
  nameProduct         String // Название товара
  price               Decimal              @db.Decimal(10, 2) // Цена товара  
  quantityProduct     Int // Количевство наличия на складе
  codeProduct         String // Код товара
  descriptionProduct  String // Описание товара
  unitOfMeasurement   Unit                 @default(PIECE) // Единицы измерения 
  provider            provider?            @relation(fields: [providerId], references: [id]) // Привязка каталога к поставщику
  providerId          Int? // id поставщика
  detailedInformation DetailedInformation? // Подробная информация о товаре

  @@index([providerId])
}

// Подробная информация товара 
model DetailedInformation {
  id                       Int                             @id @default(autoincrement())
  imageProduct             productImage[] // Изображение товара 
  description              String // Описание товара
  dopInfoUnitOfMeasurement String? // Дополнительная информация Едениц измерения
  accurateDescription      AccurateDescriptionContent[] // Точное описание
  unitPrice                UnitPriceContent? // Цена за еденицу товара
  inStockand               InStockandContent[] // Наличие на складе
  productionTime           String // Срок изгатовления
  workingConditions        WorkingConditionsContent[] // Условия работы
  deliveryTerms            DeliveryTermsContent[] // Условия доставки
  addTechnicalAdvantages   AddTechnicalAdvantagesContent[] // Дополнительные технические преимущества
  catalogProviders         CatalogProviders?               @relation(fields: [catalogProvidersId], references: [id], onDelete: Cascade) // Привязка к каталогу товаров
  catalogProvidersId       Int?                            @unique // id товара
}

model productImage {
  id                    Int                  @id @default(autoincrement())
  url                   String
  sortOrder             Int                  @default(0)
  detailedInformation   DetailedInformation? @relation(fields: [detailedInformationId], references: [id], onDelete: Cascade) // Привязка к подробной инфо о товаре
  detailedInformationId Int?
}

// Условия работы
model WorkingConditionsContent {
  id                    Int                  @id @default(autoincrement())
  type                  String // Тип Условия работы
  description           String // Описание Типа условия работы
  detailedInformation   DetailedInformation? @relation(fields: [detailedInformationId], references: [id], onDelete: Cascade) // Привязка к подробной инфо о товаре
  detailedInformationId Int?

  @@index([detailedInformationId])
}

// Условия доставки
model DeliveryTermsContent {
  id                    Int                  @id @default(autoincrement())
  type                  String // Тип условия доставки
  description           String // Описание типа
  detailedInformation   DetailedInformation? @relation(fields: [detailedInformationId], references: [id], onDelete: Cascade) // Привязка к подробной инфо о товаре
  detailedInformationId Int?

  @@index([detailedInformationId])
}

// Наличие на складе
model InStockandContent {
  id                    Int                  @id @default(autoincrement())
  warehouse             String // Склад
  availability          Boolean // Наличие или нет 
  detailedInformation   DetailedInformation? @relation(fields: [detailedInformationId], references: [id], onDelete: Cascade) // Привязка к подробной инфо о товаре
  detailedInformationId Int?

  @@index([detailedInformationId])
}

// Доп. Тех. Преймущества 
model AddTechnicalAdvantagesContent {
  id                    Int                  @id @default(autoincrement())
  type                  String // Тип Доп. тех. преймущевства
  description           String // Описание тех. преймущевства
  detailedInformation   DetailedInformation? @relation(fields: [detailedInformationId], references: [id], onDelete: Cascade) // Привязка к подробной инфо о товаре
  detailedInformationId Int?

  @@index([detailedInformationId])
}

// Контент Цены за еденицу товара
model UnitPriceContent {
  id                    Int                  @id @default(autoincrement())
  minRetail             Decimal              @db.Decimal(10, 2) // Розничная цена минимальная
  maxRetail             Decimal              @db.Decimal(10, 2) // Розничная цена максимальная
  minBulk               Decimal              @db.Decimal(10, 2) // Оптовая цена минимальная
  maxBulk               Decimal              @db.Decimal(10, 2) // Оптовая цена максимальная
  priceNote             String? // Доп. текст к цене
  warningMessage        String? // Предупреждающее сообщение о цене
  detailedInformation   DetailedInformation? @relation(fields: [detailedInformationId], references: [id], onDelete: Cascade) // Привязка к подробной инфо о товаре
  detailedInformationId Int?                 @unique // id подробной информации
}

// Точное описание товара
model AccurateDescriptionContent {
  id                    Int                  @id @default(autoincrement())
  type                  String // Тип точного описание
  description           String // Описание типа 
  compound              CompoundContent[] // Состав/Материалы товара
  detailedInformation   DetailedInformation? @relation(fields: [detailedInformationId], references: [id], onDelete: Cascade) // Привязка точного описания к подробной инфо товара
  detailedInformationId Int? // id подробной информации товара

  @@index([detailedInformationId])
}

// Контент Состава/Материалов товара
model CompoundContent {
  id                           Int                         @id @default(autoincrement())
  nameCompound                 String // Материал
  compound                     String // Состав
  accurateDescriptionContent   AccurateDescriptionContent? @relation(fields: [accurateDescriptionContentId], references: [id], onDelete: Cascade) // Привяка контента Состава/Материалов к точное описание товара 
  accurateDescriptionContentId Int? // id точного описания товара

  @@index([accurateDescriptionContentId])
}
